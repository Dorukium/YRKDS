# Veritabani
DATABASE_URL=postgresql+psycopg://yrkds:yrkds@localhost:55432/yrkds

# Izgara cozunurlugu (metre). 25 m spesifikasyon degeridir.
GRID_RESOLUTION_M=25
# Calisma siniri (WGS84). Antalya merkez 3 ilce + dogrulama noktalari.
GRID_BBOX=30.58,36.82,30.86,37.00

# Opsiyonel / anahtarli kaynaklar. Bos birakilirsak katman "veri yok" isaretlenir.
CDSAPI_KEY=
CDSAPI_UID=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# LiCSAR/COMET oturum cífresi (opsiyonel)
COMET_USER=
COMET_PASSWORD=

# API guvenligi (bos = gelistirme)
YRKDS_API_KEY=
YRKDS_RATE_LIMIT=30
# Kimlik doğrulama (ilk kurulum)
YRKDS_SECRET=degistirin-bu-gizli-anahtari
YRKDS_ADMIN_USER=admin
YRKDS_ADMIN_PASSWORD=guclu-bir-parola-en-az-12-karakter
# Uretimde true (HTTPS), yerel gelistirmede false
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# API
API_HOST=0.0.0.0
API_PORT=8000
